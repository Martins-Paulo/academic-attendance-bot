# ==============================================================================
# 🚀 UNIGAG BACKEND - MODELO DE CONFIGURAÇÃO DE AMBIENTE (.env.example)
# ==============================================================================
# Copie este arquivo para .env e preencha com suas credenciais reais:
# cp .env.example .env
# ==============================================================================

# Supabase PostgreSQL (Dashboard > Project Settings > API)
SUPABASE_URL="https://seu-projeto.supabase.co"
SUPABASE_KEY="sua-chave-anon-ou-service-role-supabase"

# Evolution API (WhatsApp Gateway - Baileys)
WHATSAPP_API_URL="http://localhost:8080"
WHATSAPP_API_KEY="sua-chave-api-global-evolution"
EVOLUTION_INSTANCE_NAME="unigag"

# Google Gemini AI (Google AI Studio: https://aistudio.google.com/)
GEMINI_API_KEY="sua-chave-api-google-gemini"
GEMINI_MODEL="gemini-1.5-flash"

# Configuração do Servidor FastAPI
PORT=8000
HOST="0.0.0.0"

# Estudante Padrão para Desenvolvimento / Testes
DEFAULT_STUDENT_ID=1