# ==============================================================================
# 🚀 UNIGAG FRONTEND - MODELO DE CONFIGURAÇÃO DE AMBIENTE (.env.example)
# ==============================================================================
# Copie este arquivo para .env e preencha com suas credenciais reais:
# cp .env.example .env
# ==============================================================================

# Supabase (Dashboard > Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL="https://seu-projeto.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="sua-chave-anonima-publica-supabase"

# Conexão Direta PostgreSQL (Utilizado pelo Payload CMS / Migrações)
DATABASE_URI="postgresql://postgres:[SUA_SENHA]@db.[SEU_PROJETO].supabase.co:5432/postgres"

# Segredo de Encriptação Local do Payload CMS
PAYLOAD_SECRET="unigag-secret-local-dev-key-substitua-em-producao"
