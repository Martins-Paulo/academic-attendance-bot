{
  "name": "@payloadcms/figma",
  "version": "1.0.0-beta.1",
  "license": "SEE LICENSE IN LICENSE.md",
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./client": {
      "import": "./dist/exports/client.js",
      "types": "./dist/exports/client.d.ts",
      "default": "./dist/exports/client.js"
    },
    "./next-image-loader": {
      "import": "./dist/next/image-loader.js",
      "types": "./dist/next/image-loader.d.ts",
      "default": "./dist/next/image-loader.js"
    },
    "./views": {
      "import": "./dist/exports/views.js",
      "types": "./dist/exports/views.d.ts",
      "default": "./dist/exports/views.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "payloadcms-figma": "bin/cli.js"
  },
  "files": [
    "package.json",
    "dist",
    "bin",
    "!dist/**/*.map"
  ],
  "dependencies": {
    "@clack/prompts": "^0.11.0",
    "@cloudflare/workers-types": "5.20260716.1",
    "@figma/rest-api-spec": "^0.34.0",
    "@sindresorhus/slugify": "^3.0.0",
    "archiver": "7.0.1",
    "arg": "^5.0.2",
    "conf": "^13.1.0",
    "cross-spawn": "7.0.6",
    "dotenv": "^16.4.5",
    "env-paths": "^3.0.0",
    "figures": "^6.1.0",
    "jose": "6.0.12",
    "jsonwebtoken": "9.0.3",
    "open": "^10.2.0",
    "openapi-fetch": "0.15.0",
    "picocolors": "1.1.1",
    "qs-esm": "^8.0.1",
    "sanitize-filename": "^1.6.4",
    "skills": "1.4.4",
    "tar": "^7.5.21",
    "terminal-link": "^5.0.0",
    "ts-morph": "^21.0.1",
    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "@payloadcms/eslint-config": "3.28.0",
    "@payloadcms/eslint-plugin": "3.28.0",
    "@payloadcms/next": "4.0.0-beta.0",
    "@payloadcms/plugin-cloud-storage": "4.0.0-beta.0",
    "@payloadcms/richtext-lexical": "4.0.0-beta.0",
    "@payloadcms/translations": "4.0.0-beta.0",
    "@payloadcms/ui": "4.0.0-beta.0",
    "@swc/cli": "0.7.7",
    "@types/archiver": "7.0.0",
    "@types/cross-spawn": "6.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.0.0",
    "@types/react": "^19",
    "@types/uuid": "^8.3.4",
    "copyfiles": "^2.4.1",
    "eslint": "9.22.0",
    "next": "^16.3.3",
    "openapi-typescript": "^7.13.0",
    "payload": "4.0.0-beta.0",
    "rimraf": "^6.1.3",
    "tsx": "4.20.6",
    "typescript": "5.7.3",
    "vitest": "4.0.15"
  },
  "peerDependencies": {
    "@payloadcms/plugin-cloud-storage": ">=4.0.0-beta.0 <4.0.0-internal",
    "@payloadcms/richtext-lexical": ">=4.0.0-beta.0 <4.0.0-internal",
    "@payloadcms/translations": ">=4.0.0-beta.0 <4.0.0-internal",
    "@payloadcms/ui": ">=4.0.0-beta.0 <4.0.0-internal",
    "payload": ">=4.0.0-beta.0 <4.0.0-internal",
    "react": "^19.0.1 || ^19.1.2 || ^19.2.1"
  },
  "peerDependenciesMeta": {
    "@payloadcms/plugin-cloud-storage": {
      "optional": true
    },
    "@payloadcms/richtext-lexical": {
      "optional": true
    }
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "pnpm build:swc && pnpm build:types && pnpm copyfiles",
    "build:swc": "swc ./src -d ./dist --config-file .swcrc --strip-leading-paths",
    "build:types": "tsc --project tsconfig.build.json",
    "clean": "rimraf -g \"{dist,*.tsbuildinfo,package}\"",
    "copyfiles": "copyfiles -u 1 \"src/**/*.{html,css,scss,ttf,woff,woff2,eot,svg,jpg,png,md}\" \"src/**/.env.example\" dist/",
    "debug:clear-tokens": "tsx scripts/clear-tokens.ts",
    "debug:expire-token": "tsx scripts/expire-token.ts",
    "debug:get-project-token": "tsx scripts/get-project-token.ts",
    "debug:jwks": "tsx scripts/test-jwks-validation.ts",
    "debug:refresh-token": "tsx scripts/refresh-token.ts",
    "debug:tokens": "tsx scripts/debug-tokens.ts",
    "debug:write-token": "tsx scripts/write-token.ts",
    "generate:types": "tsx scripts/generate-types.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "payload:cli": "tsx scripts/payload-cli.ts",
    "start": "pnpm build && node ./bin/cli.js",
    "test": "TEST_UNIT=true vitest run",
    "test:int": "TEST_INT=true vitest run --config vitest.config.int.ts",
    "test:int:watch": "TEST_INT=true vitest --config vitest.config.int.ts",
    "test:e2e": "TEST_E2E=true vitest run --config vitest.config.e2e.ts",
    "test:e2e:watch": "TEST_E2E=true vitest --config vitest.config.e2e.ts",
    "test:types": "tsc --project tsconfig.imageSizeOptions.json",
    "test:watch": "TEST_UNIT=true vitest"
  }
}